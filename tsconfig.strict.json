{
  // Strict tier of the opt-in type-check ratchet (ADR-005). Same program as
  // tsconfig.json but with noImplicitAny ON, over a small, deliberately-grown
  // file list. This is the only tier that reports TS2339 (unknown member) in a
  // JS file — under noImplicitAny:false TS suppresses it outright, even against
  // a fully-typed receiver, so a method-name typo is invisible to the base tier.
  //
  // Add a file here once its implicit-`any` params carry @param types.
  //
  // `include` lists the program's ROOTS, not the set of files that get checked.
  // `noImplicitAny` is program-wide, so every `// @ts-check` file reachable by
  // import from a root is reported too, listed or not. The unit of work is an
  // import closure, so grow this list LEAF-FIRST: `src/controllers/brands.js`
  // has 151 errors of its own but sits near the top of the graph and drags in
  // 502 across 23 files, while a leaf like `src/support/serenity/errors.js`
  // costs 1. Measure a candidate before adding it:
  //   npx tsc -p <a copy of this config with include=[the candidate]>
  // Today's list happens to pull in nothing extra only because
  // `rest-transport.js`'s repo-side imports carry no `// @ts-check` pragma.
  //
  // End state: when this list covers the base config's `include` set, the two
  // configs fold back into one with `noImplicitAny: true` and the per-file
  // `// @ts-check` pragma becomes unnecessary. See ADR-005's ratchet path for the
  // remaining cost and the order to take the files in.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": true
  },
  "include": [
    "src/support/serenity/rest-transport.js",
    // Asserts that this tier reports unknown members — the thing the base tier
    // cannot. Kept out of `test/types/base/` on purpose (see that file's header).
    "test/types/strict/**/*.js"
  ]
}
